# GrainTrust Web Dashboard & Node API - Environment Configuration
# ===================================================================

# 1. Supabase Cloud Configuration (Recommended for Production / Cloud DB)
# Replace with your project details from Supabase Dashboard -> Settings -> API:
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_secret_key_here

# 2. Local Supabase Configuration (If using `supabase start` via CLI)
# VITE_SUPABASE_URL=http://localhost:54321
# VITE_SUPABASE_ANON_KEY=your_local_anon_key
# SUPABASE_SERVICE_ROLE_KEY=your_local_service_role_key

# 3. Node API Server Settings
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
